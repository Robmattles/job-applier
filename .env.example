# Copy to .env.local and fill in. .env.local is gitignored.
#
# The account id and email were hardcoded throughout until this repo was
# made public. They're not secrets exactly — an AWS account id is not a
# credential — but together they name a specific person's live
# infrastructure, which is more than a reader of the code needs.
JOB_APPLIER_ACCOUNT_ID=000000000000
JOB_APPLIER_REGION=us-east-1
JOB_APPLIER_EMAIL=you@example.com
